[Unit]
Description=NimRoute (OpenAI-compatible, keyless opencode free models)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=REPLACE_WITH_PATH
ExecStart=REPLACE_WITH_PATH/nimroute
# port comes from server.port in config.yml (default 5419): no PORT env
# here, it would silently override the config.
Restart=on-failure
RestartSec=3
# optional: Environment=CONFIG_FILE=/path/to/config.yml

[Install]
WantedBy=default.target
