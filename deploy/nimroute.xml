<!-- windows service definition for winsw (https://github.com/winsw/winsw).
1. download WinSW-x64.exe next to nimroute.exe, rename to nimroute-service.exe
2. put this file next to it as nimroute-service.xml
3. edit the paths below, then: nimroute-service.exe install && nimroute-service.exe start -->
<service>
  <id>nimroute</id>
  <name>NimRoute</name>
  <description>OpenAI-compatible proxy: keyless opencode free models, optional NVIDIA NIM keys</description>
  <executable>REPLACE_WITH_PATH\nimroute.exe</executable>
  <workingdirectory>REPLACE_WITH_PATH</workingdirectory>
  <!-- port comes from server.port in config.yml: no PORT env here, it
       would silently override the config. -->
  <!-- optional: <env name="CONFIG_FILE" value="C:\nimroute\config.yml"/> -->
  <log mode="roll" />
  <onfailure action="restart" delay="3 sec"/>
</service>
